MODEL=gemma:e2b
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_OUTPUT_DIMS=768
# MODEL=qwen3.5:4b
# EMBEDDING_MODEL=qwen3-embedding:latest
# EMBEDDING_OUTPUT_DIMS=1024

EMBEDDING_DB_DIR=.DB
EMBEDDING_DB_TABLE_NAME=embedding

# CONFIGURABLE SECTION (you may change the settings below)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# currently does not support .ipynb 
ALLOWED_FILETYPES=.py,.c,.h,.cpp,.hpp,.html,.js,.css
DIRNAMES_TO_IGNORE=env,venv,.venv,.env,.local,.cache,__pycache__,.pytest_cache,node_modules,Downloads

